{
  "name": "dhuanalert-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DhuanAlert Monorepo — TypeScript Backend (Express), React Frontend (Vite), and Python ML Engine",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "test:model": "python -m pytest ml-model",
    "test": "npm run test:backend && npm run test:model"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
