# ==============================================================================
# 🌫️ DhuanAlert — Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External Data Sources & Ingestion APIs
# ------------------------------------------------------------------------------
# NASA FIRMS Map Key (Area API for real-time VIIRS/MODIS active fire detections)
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Default/Mock fallback: leave as SAMPLE or empty to use verified bundled snapshot
NASA_FIRMS_MAP_KEY=SAMPLE

# Open-Meteo GFS Atmospheric Forecast API (Wind u/v, BLH, Temp, Humidity)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# OpenAQ API Key (for real ground monitoring station PM2.5 validation)
# Register at: https://openaq.org/
OPENAQ_API_KEY=SAMPLE

# WAQI (World Air Quality Index) Token
# Register at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=SAMPLE

# ------------------------------------------------------------------------------
# 2. AWS Cloud Services (Optional / Ready for Deployment)
# ------------------------------------------------------------------------------
# Set to 'ap-south-1' (AWS Mumbai) or your preferred AWS region
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock LLM Model ID for Bilingual GenAI Advisory Synthesis
# Supported: anthropic.claude-3-haiku-20240307-v1:0, amazon.titan-text-express-v1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon S3 Bucket Name for Raw Ingestion Snapshots & Processed Run GeoJSON
# If left empty, DhuanAlert automatically falls back to local storage (output/api-runs/)
AWS_S3_BUCKET_NAME=

# Amazon EventBridge Cron Expression for Ingestion (Default: every 3 hours)
EVENTBRIDGE_SCHEDULE_CRON=0 */3 * * ? *

# ------------------------------------------------------------------------------
# 3. Server & Runtime Ports
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
PYTHON_PATH=python
CORS_ORIGIN=http://localhost:5173

# Frontend Vite API Base URL
VITE_API_BASE_URL=http://127.0.0.1:3000
