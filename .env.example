# ==============================================================================
# 🌫️ DhuanAlert — Centralised Platform Environment Configuration (.env.example)
# ==============================================================================
# This is the single, centralised configuration file for the entire monorepo:
# Backend (Express), Frontend (React/Vite), and ML Model (Python).
# Copy this file to '.env' and populate your API credentials as needed.
# ==============================================================================

# ==============================================================================
# 1. EXTERNAL DATA SOURCE APIS (PHYSICS & INGESTION)
# ==============================================================================

# [API 1] NASA FIRMS (Fire Information for Resource Management System)
# Purpose: Real-time satellite active fire detection (VIIRS / MODIS) over Punjab & Haryana.
# Get a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Default / Fallback: Leave as "SAMPLE" or empty to use verified bundled snapshot (sample_fires.json).
NASA_FIRMS_MAP_KEY=SAMPLE

# [API 2] Open-Meteo GFS Atmospheric Forecast API
# Purpose: Real-time GFS wind speed, wind direction, boundary layer height (BLH), temperature & humidity.
# Free public endpoint (No key required): https://api.open-meteo.com/v1/forecast
# Fallback: Bundled sample_weather.json if network is unreachable.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# [API 3] OpenAQ Air Quality Monitoring API
# Purpose: Ground-truth PM2.5 observation station backtesting & lead-time verification.
# Get an API key at: https://openaq.org/
# Default / Fallback: Leave as "SAMPLE" to use verified CAAQMS Delhi stations.
OPENAQ_API_KEY=SAMPLE

# [API 4] WAQI (World Air Quality Index) Token
# Purpose: Real-time PM2.5 / AQI live contextual readings across Delhi-NCR monitoring stations.
# Get a free token at: https://aqicn.org/data-platform/token/
# Default / Fallback: Leave as "SAMPLE" for default reference stations.
WAQI_API_TOKEN=SAMPLE


# ==============================================================================
# 2. AWS CLOUD INTEGRATION & SERVICES (OPTIONAL FOR DEPLOYMENT)
# ==============================================================================

# AWS Region (Default: Mumbai / ap-south-1)
AWS_REGION=ap-south-1

# AWS IAM Credentials (Leave blank for local offline mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# [AWS Service 1] Amazon Bedrock LLM Model ID
# Purpose: Generates grounded, bilingual (Hindi & English) operational school advisories.
# Supported IDs:
#   - anthropic.claude-3-haiku-20240307-v1:0 (Recommended for fast inference)
#   - anthropic.claude-3-5-sonnet-20240620-v1:0
#   - amazon.titan-text-express-v1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# [AWS Service 2] Amazon S3 Bucket Name
# Purpose: Storage for raw NASA/weather snapshots and processed forecast GeoJSON / advisory JSON.
# Fallback: If blank, automatically persists to local disk (output/api-runs/{run_id}/).
AWS_S3_BUCKET_NAME=

# [AWS Service 3] AWS EventBridge Schedule Expression
# Purpose: Automated recurring ingestion trigger (default: every 3 hours).
EVENTBRIDGE_SCHEDULE_CRON=0 */3 * * ? *


# ==============================================================================
# 3. BACKEND API SERVER CONFIGURATION (Node.js / Express / TypeScript)
# ==============================================================================

PORT=3000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PYTHON_EXECUTABLE=python


# ==============================================================================
# 4. FRONTEND DASHBOARD CONFIGURATION (React / Vite)
# ==============================================================================

# API Base URL consumed by Vite frontend (http://127.0.0.1:3000)
VITE_API_BASE_URL=http://127.0.0.1:3000
